# URL del backend. Déjala vacía en local para usar el proxy de Vite (/api → http://localhost:3000)
VITE_API_BASE_URL=

# Firebase (consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK)
# Son valores públicos del cliente web. NUNCA pongas aquí la cuenta de servicio (va solo en el backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
